module FileSystem.Lock exposing
    ( Error(..)
    , RetryOptions
    , withLock
    )


{-| Lockfiles. A lock can only be held by a single process at a time, and can
thus be used to avoid having two or more programs working on a set of files
simultaniously.

This implementation is based on [proper-lockfile](https://www.npmjs.com/package/proper-lockfile).

@docs withLock, RetryOptions, Error
-}


import FileSystem
import FileSystem.Path as Path exposing (Path)
import Task exposing (Task)
import Process
import Time


{-| Why [`withLock`](#withLock) did not answer what its task did.

* `AlreadyLocked`: another process holds the lock, and went on holding it for
  every retry.
* `UnexpectedError`: the file system refused something the lock needed, whether
  taking the lock or keeping it fresh while the task ran.
* `TaskFailed`: the lock was taken, and the task failed.
-}
type Error e
    = AlreadyLocked Path
    | UnexpectedError { path : Path, error : FileSystem.Error }
    | TaskFailed e


{-| How often, and at what interval, to retry aquiring a lock.
-}
type alias RetryOptions =
    { attempts : Int
    , millisecondsBetween : Int
    }


{-| Run a task while holding the lock with the given `Path`, and release the lock
when the task is done, however it ends: when it succeeds, when it fails, and
when it is cancelled.

While the lock is held, other processes will fail to aquire it. A lock nobody
has refreshed for five seconds is stale, and is taken over, so while the task
runs the lock is refreshed every second.

It was a TEA component, whose heartbeat was a command the caller had to keep
running (geng-lang `m1b-source.md` §SO18).
-}
withLock : FileSystem.Permission -> Maybe RetryOptions -> Path -> Task e a -> Task (Error e) a
withLock fsPerm retryOptions path task =
    Task.bracket
        (aquire fsPerm retryOptions (toLockPath path) 0)
        (\lockPath ->
            FileSystem.remove fsPerm { recursive = True } lockPath
                |> Task.map (\_ -> {})
                |> Task.onError (\_ -> Task.succeed {})
        )
        (\lockPath ->
            Task.race
                (Task.mapError TaskFailed task)
                [ heartbeat fsPerm lockPath ]
        )


aquire : FileSystem.Permission -> Maybe RetryOptions -> Path -> Int -> Task (Error e) Path
aquire fsPerm retryOptions lockPath attempt =
    FileSystem.makeDirectory fsPerm { recursive = False } lockPath
        |> Task.onError
            (\fsErr ->
                if FileSystem.errorIsFileExists fsErr then
                    -- Lock already exists. Need to retrieve modification time
                    -- to figure out how long we should wait, or if it is stale
                    FileSystem.metadata fsPerm { resolveLink = False } lockPath
                        |> Task.andThen (\meta -> Time.now |> Task.map (\time -> Ok { time = time, meta = meta }))
                        |> Task.onError (\metaErr -> Task.succeed (Err metaErr))
                        |> Task.andThen
                            (\result ->
                                when result is
                                    Ok existing ->
                                        aquireExisting fsPerm retryOptions lockPath attempt existing

                                    Err metaErr ->
                                        if FileSystem.errorIsNoSuchFileOrDirectory metaErr then
                                            -- Lock was removed while we asked for metadata
                                            aquire fsPerm retryOptions lockPath (attempt + 1)

                                        else
                                            Task.fail (UnexpectedError { path = fromLockPath lockPath, error = metaErr })
                            )

                else
                    Task.fail (UnexpectedError { path = fromLockPath lockPath, error = fsErr })
            )


aquireExisting : FileSystem.Permission -> Maybe RetryOptions -> Path -> Int -> { time : Time.Posix, meta : FileSystem.Metadata } -> Task (Error e) Path
aquireExisting fsPerm retryOptions lockPath attempt { time, meta } =
    if Time.posixToMillis time - Time.posixToMillis meta.lastAccessed > 5000 then
        -- Lock is stale, let's try again
        FileSystem.remove fsPerm { recursive = True } lockPath
            |> Task.onError (\_ -> Task.succeed lockPath)
            |> Task.andThen (\_ -> aquire fsPerm retryOptions lockPath (attempt + 1))

    else
        when retryOptions is
            Just opts ->
                if opts.attempts > attempt then
                    Process.sleep (toFloat opts.millisecondsBetween)
                        |> Task.andThen (\_ -> aquire fsPerm retryOptions lockPath (attempt + 1))

                else
                    Task.fail (AlreadyLocked (fromLockPath lockPath))

            Nothing ->
                Task.fail (AlreadyLocked (fromLockPath lockPath))


{-| Touch the lock every second, so that no other process takes it for stale.
It never completes, and fails only if the touch does.
-}
heartbeat : FileSystem.Permission -> Path -> Task (Error e) a
heartbeat fsPerm lockPath =
    Process.sleep 1000
        |> Task.andThen (\_ -> Time.now)
        |> Task.andThen
            (\time ->
                FileSystem.changeTimes
                    fsPerm
                    { lastAccessed = time
                    , lastModified = time
                    , resolveLink = False
                    }
                    lockPath
                    |> Task.mapError (\error -> UnexpectedError { path = fromLockPath lockPath, error = error })
            )
        |> Task.andThen (\_ -> heartbeat fsPerm lockPath)


toLockPath : Path -> Path
toLockPath path =
    Path.fromPosixString ".lock"
        |> Path.prepend path


fromLockPath : Path -> Path
fromLockPath lockPath =
    Path.parentPath lockPath
        |> Maybe.withDefault lockPath
