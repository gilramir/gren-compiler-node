module Compiler.Outline exposing
    ( Outline (..)
    , AppOutline
    , PkgOutline
    , Exposed (..)
    , PackageTarget (..)
    , Source (..)
    , fileName
    , defaultSummary
    --
    , ReadFromPathError (..)
    , readFromPath
    , readFromString
    , readSources
    , readErrorToString
    --
    , FindSourceFilesError (..)
    , findSourceFiles
    --
    , toToml
    , setDependency
    , removeDependency
    --
    , pkgJsonDecoder
    , toJson
    )


{-| Module for working with `geng.toml` files.

A project is a directory with a `geng.toml` in it, which is an application's or
a package's (Geng's `packaging.md` K3 and K8):

    [application]
    geng = "0.6.0 <= v < 0.7.0"
    runtime = "node"

    [dependencies]
    "github.com/geng-language/node" = "6.1.0 <= v < 7.0.0"

    [sources]
    "github.com/geng-language/node" = { path = "../node" }

It was `gren.json`. The JSON shape survives as what the front end hands the
backend and what a package bundle holds, since neither is a file anyone writes,
and it is what [toJson](#toJson) and [pkgJsonDecoder](#pkgJsonDecoder) speak.

@docs Outline, AppOutline, PkgOutline, Exposed, PackageTarget, Source, fileName, defaultSummary

## Read from disk

@docs readFromPath, readFromString, readSources, ReadFromPathError, readErrorToString, findSourceFiles, FindSourceFilesError

## Write

@docs toToml, setDependency, removeDependency

## JSON

@docs pkgJsonDecoder, toJson
-}

import Bytes
import SemanticVersion exposing (SemanticVersion)
import SemanticVersionRange exposing (SemanticVersionRange)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Json.Decode
import Json.Encode as Encode
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.License as License exposing (License)
import Compiler.Platform as Platform exposing (Platform)
import Compiler.Runtime as Runtime exposing (Runtime)
import Dict exposing (Dict)
import Task exposing (Task)
import Toml
import Toml.Decode as Decode exposing (Decoder)
import Toml.Edit
import Toml.Table


{-| A project's manifest, an application's or a package's.
-}
type Outline
    = App AppOutline
    | Pkg PkgOutline


{-| An application chooses what it is built for and with.

`gengVersion` is the range of compilers it builds with. `dependencies` are
ranges, as a package's are: the versions chosen are the lock file's business,
not the manifest's. `platform` is its runtime, one of the three the compiler
builds for, and `target` what it is built for, `js` unless it says otherwise.
-}
type alias AppOutline =
    { platform : Platform
    , target : String
    , sourceDirectories : Array Path
    , gengVersion : SemanticVersionRange
    , dependencies : Dict String SemanticVersionRange
    , sources : Dict String Source
    }


{-| A package declares what it is and what it works with.

A package may have `[sources]` too. They apply when the package is the project
being built, and never when it is someone else's dependency (K9).

Its `runtime` may be any of D24's, including those the compiler does not build
for, which a build refuses when it needs the package (D319). Its `target` is
what it declares, if it declares one; what its externs serve is derived by the
backend and checked against it (D318).
-}
type alias PkgOutline =
    { runtime : Runtime
    , target : Maybe PackageTarget
    , name : PackageName
    , summary : String
    , license : License
    , version : SemanticVersion
    , exposedModules : Exposed
    , gengVersion : SemanticVersionRange
    , dependencies : Dict String SemanticVersionRange
    , sources : Dict String Source
    }


{-| A package's declared `target`: `"any"`, or the targets its externs serve,
such as `["js", "wasm"]`.
-}
type PackageTarget
    = AnyTarget
    | Targets (Array String)


{-| Exposed modules in [PkgOutline](#PkgOutline). Modules that become available
when you're importing the package as a dependency.
-}
type Exposed
    = ExposedArray (Array ModuleName)
    | ExposedDict (Dict String (Array ModuleName))


{-| Where the packages under a prefix come from, instead of the git server the
identifier names (K9). The key the source is filed under is an identifier, or a
prefix of some, and the longest key that is a prefix of an identifier is the one
that applies.

  - `Rewrite`: `"git.corp.example/" = "ssh://git@git.corp.example/"`. A key that
    ends in a slash says how to reach everything below it: the URL is the value
    followed by the rest of the repository's path. Where a repository ends is
    still found the usual way.
  - `Repository`: `"github.com/x/platforms" = "https://mirror.example/p.git"`.
    The key is where a repository ends, and the value is where to clone it from.
  - `LocalPath`: `"github.com/x/y" = { path = "../y" }`. A directory holds the
    package, or with a longer identifier the directory below it that the rest of
    the identifier names. The version is what its manifest says.
  - `Commit`: `"codeberg.org/x/toml" = { git = "https://…", rev = "3f2a…" }`. The
    key is a repository root, and every package in it is taken from that commit
    rather than from a tag.
-}
type Source
    = Rewrite String
    | Repository String
    | LocalPath Path
    | Commit { url : String, rev : String }


{-| `geng.toml`
-}
fileName : String
fileName =
    "geng.toml"


{-| The default summary used when creating `geng.toml` using `geng init`.
-}
defaultSummary : String
defaultSummary =
    "helpful summary of your project, less than 80 characters"


-- READING


{-| The types of errors that can occur when reading an `Outline` from the filesystem.
-}
type ReadFromPathError
    = FromPathFileSystemError FileSystem.Error
    | FromPathInvalidToml Decode.Error


{-| Read the `Outline` located at the given `Path`, which names the `geng.toml`.
-}
readFromPath : FileSystem.Permission -> Path -> Task ReadFromPathError Outline
readFromPath fsPerm path =
    FileSystem.readFile fsPerm path
        |> Task.mapError FromPathFileSystemError
        |> Task.andThen
            (\bytes ->
                when Decode.fromBytes decoder bytes is
                    Ok outline ->
                        Task.succeed outline

                    Err err ->
                        Task.fail (FromPathInvalidToml err)
            )


{-| Read an `Outline` from the text of a `geng.toml`.
-}
readFromString : String -> Result Decode.Error Outline
readFromString =
    Decode.fromString decoder


{-| Read the `[sources]` of a file that has nothing else, which is what the
user's `config.toml` is: the same table applied to every build on the machine
(K9).
-}
readSources : String -> Result Decode.Error (Dict String Source)
readSources =
    Decode.fromString
        (Decode.succeed (\{} sources -> sources)
            |> Decode.andMap (onlyKeys [ "sources" ])
            |> Decode.andMap sourcesTableDecoder
        )


{-| What was wrong with a `geng.toml`, as a line of text.
-}
readErrorToString : Decode.Error -> String
readErrorToString =
    Decode.errorToString


decoder : Decoder Outline
decoder =
    Decode.table
        |> Decode.andThen
            (\top ->
                when
                    { app = Toml.Table.member "application" top
                    , pkg = Toml.Table.member "package" top
                    }
                is
                    { app = True, pkg = True } ->
                        Decode.fail "a manifest has an [application] table or a [package] table, not both"

                    { app = True } ->
                        Decode.map App appDecoder

                    { pkg = True } ->
                        Decode.map Pkg pkgDecoder

                    _ ->
                        Decode.fail "a manifest needs an [application] table or a [package] table"
            )


{-| Refuse a key a table does not have, naming it. A misspelt key is otherwise
a setting silently left at its default.
-}
onlyKeys : Array String -> Decoder {}
onlyKeys allowed =
    Decode.table
        |> Decode.andThen
            (\table ->
                when Array.findFirst (\key -> not (Array.member key allowed)) (Toml.Table.keys table) is
                    Just { value = key } ->
                        Decode.fail
                            ("\""
                                ++ key
                                ++ "\" is not a key here; the keys are "
                                ++ String.join ", " allowed
                            )

                    Nothing ->
                        Decode.succeed {}
            )


appDecoder : Decoder AppOutline
appDecoder =
    Decode.succeed
        (\{} application dependencies sources ->
            { platform = application.platform
            , target = application.target
            , sourceDirectories = application.sourceDirectories
            , gengVersion = application.gengVersion
            , dependencies = dependencies
            , sources = sources
            }
        )
        |> Decode.andMap (onlyKeys [ "application", "dependencies", "sources" ])
        |> Decode.andMap (Decode.field "application" applicationTableDecoder)
        |> Decode.andMap dependenciesTableDecoder
        |> Decode.andMap sourcesTableDecoder


applicationTableDecoder : Decoder { platform : Platform, target : String, sourceDirectories : Array Path, gengVersion : SemanticVersionRange }
applicationTableDecoder =
    Decode.succeed
        (\{} gengVersion platform target sourceDirectories ->
            { platform = platform
            , target = Maybe.withDefault "js" target
            , sourceDirectories = Maybe.withDefault [ Path.fromPosixString "src" ] sourceDirectories
            , gengVersion = gengVersion
            }
        )
        |> Decode.andMap (onlyKeys [ "geng", "runtime", "target", "source-directories" ])
        |> Decode.andMap (Decode.field "geng" rangeDecoder)
        |> Decode.andMap (Decode.field "runtime" runtimeDecoder)
        |> Decode.andMap (Decode.optionalField "target" (Decode.string |> Decode.andThen oneTarget))
        |> Decode.andMap (Decode.optionalField "source-directories" (Decode.array srcDirDecoder))


pkgDecoder : Decoder PkgOutline
pkgDecoder =
    Decode.succeed
        (\{} package platform exposed dependencies sources ->
            { runtime = platform.runtime
            , target = platform.target
            , name = package.name
            , summary = package.summary
            , license = package.license
            , version = package.version
            , exposedModules = exposed
            , gengVersion = package.gengVersion
            , dependencies = dependencies
            , sources = sources
            }
        )
        |> Decode.andMap (onlyKeys [ "package", "platform", "modules", "dependencies", "sources" ])
        |> Decode.andMap (Decode.field "package" packageTableDecoder)
        |> Decode.andMap (Decode.field "platform" platformTableDecoder)
        |> Decode.andMap (Decode.at [ "modules", "exposed" ] exposedDecoder)
        |> Decode.andMap dependenciesTableDecoder
        |> Decode.andMap sourcesTableDecoder


packageTableDecoder :
    Decoder
        { name : PackageName
        , summary : String
        , license : License
        , version : SemanticVersion
        , gengVersion : SemanticVersionRange
        }
packageTableDecoder =
    Decode.succeed
        (\{} name version summary license gengVersion ->
            { name = name
            , summary = Maybe.withDefault "" summary
            , license = license
            , version = version
            , gengVersion = gengVersion
            }
        )
        |> Decode.andMap (onlyKeys [ "name", "version", "summary", "license", "geng" ])
        |> Decode.andMap (Decode.field "name" packageNameDecoder)
        |> Decode.andMap (Decode.field "version" versionDecoder)
        |> Decode.andMap (Decode.optionalField "summary" Decode.string)
        |> Decode.andMap (Decode.field "license" licenseDecoder)
        |> Decode.andMap (Decode.field "geng" rangeDecoder)


platformTableDecoder : Decoder { runtime : Runtime, target : Maybe PackageTarget }
platformTableDecoder =
    Decode.succeed (\{} runtime target -> { runtime = runtime, target = target })
        |> Decode.andMap (onlyKeys [ "runtime", "target" ])
        |> Decode.andMap (Decode.field "runtime" packageRuntimeDecoder)
        |> Decode.andMap (Decode.optionalField "target" packageTargetDecoder)


{-| An application's runtime. The compiler builds for three of D24's, which are
the platforms it had before it had the hierarchy: `any` is what `common` was.
-}
runtimeDecoder : Decoder Platform
runtimeDecoder =
    Decode.string
        |> Decode.andThen
            (\value ->
                when value is
                    "any" ->
                        Decode.succeed Platform.Common

                    "browser" ->
                        Decode.succeed Platform.Browser

                    "node" ->
                        Decode.succeed Platform.Node

                    _ ->
                        if Array.member value [ "beam", "os", "linux", "darwin", "windows", "host" ] then
                            Decode.fail ("the runtime \"" ++ value ++ "\" is not one this compiler builds for; it builds for any, browser and node")

                        else
                            Decode.fail ("\"" ++ value ++ "\" is not a runtime; the runtimes are any, browser, node, beam, os, linux, darwin, windows and host")
            )


{-| A package's runtime, which may be any of D24's (D319). One the compiler does
not build for is refused when a build needs the package, not here, so a package
for `beam` or `os` can say so.
-}
packageRuntimeDecoder : Decoder Runtime
packageRuntimeDecoder =
    Decode.string
        |> Decode.andThen
            (\value ->
                when Runtime.fromString value is
                    Just runtime ->
                        Decode.succeed runtime

                    Nothing ->
                        Decode.fail ("\"" ++ value ++ "\" is not a runtime; the runtimes are any, browser, node, beam, os, linux, darwin, windows and host")
            )


{-| The targets, D77's table's right-hand column.
-}
targets : Array String
targets =
    [ "beam", "js", "native", "wasm" ]


oneTarget : String -> Decoder String
oneTarget value =
    if Array.member value targets then
        Decode.succeed value

    else
        Decode.fail ("\"" ++ value ++ "\" is not a target; the targets are " ++ String.join ", " targets)


{-| A package's `target`: `"any"`, or an array of targets, which the backend
holds to what the package's externs serve (D50, D318). A single target is not a
set, and `js` externs serve `wasm` as well, so it is refused with the form to
write.
-}
packageTargetDecoder : Decoder PackageTarget
packageTargetDecoder =
    Decode.oneOf
        [ Decode.string
            |> Decode.andThen
                (\value ->
                    if value == "any" then
                        Decode.succeed AnyTarget

                    else
                        Decode.fail ("a package's target is \"any\" or an array of targets, such as [\"" ++ value ++ "\"]")
                )
        , Decode.array (Decode.string |> Decode.andThen oneTarget)
            |> Decode.andThen
                (\values ->
                    let
                        sorted =
                            Array.sort values
                    in
                    if Array.isEmpty values then
                        Decode.fail "a package's target names at least one target; a package that builds for every target is \"any\""

                    else if (Array.foldl (\value acc -> { previous = Just value, twice = acc.twice || acc.previous == Just value }) { previous = Nothing, twice = False } sorted).twice then
                        Decode.fail "a target is named twice"

                    else
                        Decode.succeed (Targets sorted)
                )
        ]


dependenciesTableDecoder : Decoder (Dict String SemanticVersionRange)
dependenciesTableDecoder =
    Decode.optionalField "dependencies" dependenciesDecoder
        |> Decode.map (Maybe.withDefault Dict.empty)


{-| A dependency table, whose every key has to be a package identifier and every
value a range.
-}
dependenciesDecoder : Decoder (Dict String SemanticVersionRange)
dependenciesDecoder =
    Decode.dict rangeDecoder
        |> Decode.andThen
            (\deps ->
                when Array.findFirst (\key -> PackageName.fromString key == Nothing) (Dict.keys deps) is
                    Just { value = badKey } ->
                        Decode.fail ("\"" ++ badKey ++ "\" is not a package identifier")

                    Nothing ->
                        Decode.succeed deps
            )


sourcesTableDecoder : Decoder (Dict String Source)
sourcesTableDecoder =
    Decode.optionalField "sources" sourcesDecoder
        |> Decode.map (Maybe.withDefault Dict.empty)


type RawSource
    = RawUrl String
    | RawPath String
    | RawCommit { url : String, rev : String }


sourcesDecoder : Decoder (Dict String Source)
sourcesDecoder =
    Decode.dict
        (Decode.oneOf
            [ Decode.map RawUrl Decode.string
            , Decode.succeed (\{} path -> RawPath path)
                |> Decode.andMap (onlyKeys [ "path" ])
                |> Decode.andMap (Decode.field "path" Decode.string)
            , Decode.succeed (\{} url rev -> RawCommit { url = url, rev = rev })
                |> Decode.andMap (onlyKeys [ "git", "rev" ])
                |> Decode.andMap (Decode.field "git" Decode.string)
                |> Decode.andMap (Decode.field "rev" Decode.string)
            ]
        )
        |> Decode.andThen
            (\raw ->
                Dict.foldl
                    (\key value acc ->
                        Decode.andThen
                            (\done ->
                                when sourceFromRaw key value is
                                    Ok source ->
                                        Decode.succeed (Dict.set key source done)

                                    Err message ->
                                        Decode.field key (Decode.fail message)
                            )
                            acc
                    )
                    (Decode.succeed Dict.empty)
                    raw
            )


sourceFromRaw : String -> RawSource -> Result String Source
sourceFromRaw key raw =
    let
        endsInSlash =
            String.endsWith "/" key

        prefix =
            if endsInSlash then
                String.dropLast 1 key

            else
                key
    in
    if prefix == "core" then
        Err "core comes with the compiler, and nothing can say where else to find it"

    else if not (PackageName.isPrefix prefix) then
        Err "a source's key is a host, or a host and the path elements that begin some identifiers"

    else
        when raw is
            RawUrl url ->
                if endsInSlash then
                    if String.endsWith "/" url then
                        Ok (Rewrite url)

                    else
                        Err "a key that ends in a slash rewrites a prefix of URLs, so its value has to end in a slash too"

                else
                    Ok (Repository url)

            RawPath path ->
                if path == "" then
                    Err "a path source needs a directory"

                else
                    Ok (LocalPath (Path.fromPosixString path))

            RawCommit commit ->
                if endsInSlash then
                    Err "a git source names one repository, so its key cannot end in a slash"

                else if String.count commit.rev < 7 || not (String.all Char.isHexDigit commit.rev) then
                    Err "a git source's rev is a commit hash, at least seven hexadecimal digits"

                else
                    Ok (Commit commit)


srcDirDecoder : Decoder Path
srcDirDecoder =
    Decode.string
        |> Decode.map Path.fromPosixString
        |> Decode.andThen
            (\path ->
                if path.root == "" then
                    Decode.succeed path

                else
                    Decode.fail ("a source directory is relative to the manifest, and " ++ Path.toPosixString path ++ " is absolute")
            )


exposedDecoder : Decoder Exposed
exposedDecoder =
    Decode.oneOf
        [ Decode.array moduleNameDecoder
            |> Decode.map ExposedArray
        , Decode.dict (Decode.array moduleNameDecoder)
            |> Decode.map ExposedDict
        ]


moduleNameDecoder : Decoder ModuleName
moduleNameDecoder =
    fromStringDecoder "a module name" ModuleName.fromString


packageNameDecoder : Decoder PackageName
packageNameDecoder =
    fromStringDecoder "a package identifier" PackageName.fromString


versionDecoder : Decoder SemanticVersion
versionDecoder =
    fromStringDecoder "a version, like 1.0.0," SemanticVersion.fromString


rangeDecoder : Decoder SemanticVersionRange
rangeDecoder =
    fromStringDecoder "a version range, like 1.0.0 <= v < 2.0.0," SemanticVersionRange.fromString


licenseDecoder : Decoder License
licenseDecoder =
    fromStringDecoder "an OSI approved SPDX license identifier" License.fromString


fromStringDecoder : String -> (String -> Maybe a) -> Decoder a
fromStringDecoder what parse =
    Decode.string
        |> Decode.andThen
            (\value ->
                when parse value is
                    Just parsed ->
                        Decode.succeed parsed

                    Nothing ->
                        Decode.fail ("\"" ++ value ++ "\" is not " ++ what)
            )


-- SOURCE FILES


{-| The types of errors  that can occur when retrieving the source code of a project.
-}
type FindSourceFilesError
    = FileSystemError FileSystem.Error
    | FilePathInvalidModuleName { path : Path, inferredModuleName : String }
    | FileContentNotValidString Path


{-| Find the source files of a given project.

When used on `core`, or a package with externs, this function can return JavaScript files.
-}
findSourceFiles : FileSystem.Permission -> Outline -> Path -> Task FindSourceFilesError (Array { path : Path, moduleName : ModuleName, source : String })
findSourceFiles fsPerm outline outlinePath =
    let
        sourceDirs =
            when outline is
                App appOutline ->
                    appOutline.sourceDirectories

                Pkg _ ->
                    [ Path.fromPosixString "src"
                    ]
    in
    Array.map (\srcDir -> Path.append srcDir outlinePath) sourceDirs
        |> Array.map (findSourceFilesHelp fsPerm Path.empty)
        |> Task.concurrent
        |> Task.map Array.flatten
        |> Task.andThen (\paths -> Task.concurrent <| Array.map (readSourceFile fsPerm) paths)


findSourceFilesHelp : FileSystem.Permission -> Path -> Path -> Task FindSourceFilesError (Array { absolute : Path, relative : Path })
findSourceFilesHelp fsPerm local root =
    FileSystem.listDirectory fsPerm root
        |> Task.mapError FileSystemError
        |> Task.andThen
            (\paths ->
                paths
                    |> Array.mapAndKeepJust
                        (\entry ->
                            when entry.entityType is
                                FileSystem.Directory ->
                                    Just <| findSourceFilesHelp fsPerm (Path.append entry.path local) (Path.append entry.path root)

                                FileSystem.File ->
                                    let
                                        fullLocalPath =
                                            Path.append entry.path local
                                    in
                                    if entry.path.extension == "geng" || isKernelCode fullLocalPath || isExternCode fullLocalPath then
                                        Just <|
                                            Task.succeed
                                                [ { absolute = Path.append entry.path root
                                                  , relative = fullLocalPath
                                                  }
                                                ]

                                    else
                                        Nothing

                                _ ->
                                    Nothing
                        )
                    |> Task.concurrent
                    |> Task.map Array.flatten
            )


isKernelCode : Path -> Bool
isKernelCode path =
    if path.extension == "js" then
        when Path.parentPath path is
            Just parent ->
                parent == kernelCodePrefixPath

            Nothing ->
                False

    else
        False


{-| A `js` extern's implementation, `Ext/<Module>.js` under a source directory
(`ffi.md` F1, D198). It is read with the Gren sources, under the module name
`Ext.<Module>`, the way kernel code is read under `Gren.Kernel.<Module>`.
-}
isExternCode : Path -> Bool
isExternCode path =
    if path.extension == "js" then
        when Path.parentPath path is
            Just parent ->
                parent == externCodePrefixPath

            Nothing ->
                False

    else
        False


externCodePrefixPath : Path
externCodePrefixPath =
    Path.fromPosixString "Ext"


kernelCodePrefixPath : Path
kernelCodePrefixPath =
    Path.fromPosixString "Gren/Kernel"


readSourceFile : FileSystem.Permission -> { absolute : Path, relative : Path } -> Task FindSourceFilesError { path : Path, moduleName : ModuleName, source : String }
readSourceFile fsPerm { absolute, relative } =
    FileSystem.readFile fsPerm absolute
        |> Task.mapError FileSystemError
        |> Task.andThen
            (\source ->
                let
                    inferredModuleName =
                        { relative | extension = "" }
                            |> Path.toPosixString
                            |> String.replace "/" "."

                    sourceString =
                        Bytes.toString source
                in
                when { moduleName = ModuleName.fromString inferredModuleName, sourceString = sourceString } is
                    { moduleName = Just modName, sourceString = Just srcStr } ->
                        Task.succeed <|
                            { path = absolute
                            , moduleName = modName
                            , source = srcStr
                            }

                    { moduleName = Nothing } ->
                        Task.fail <|
                            FilePathInvalidModuleName
                                { path = relative
                                , inferredModuleName = inferredModuleName
                                }

                    { sourceString = Nothing } ->
                        Task.fail <|
                            FileContentNotValidString relative
            )


-- WRITING


{-| A new `geng.toml` for an outline, as `geng init` writes one. `[sources]` is
left out: a new project has none.
-}
toToml : Outline -> String
toToml outline =
    let
        line key value =
            key ++ " = " ++ value ++ "\n"

        dependencies deps =
            "\n[dependencies]\n"
                ++ (Dict.foldl
                        (\name range acc -> acc ++ line (quote name) (quote (SemanticVersionRange.toString range)))
                        ""
                        deps
                   )

        runtime platform =
            quote <|
                when platform is
                    Platform.Common ->
                        "any"

                    Platform.Browser ->
                        "browser"

                    Platform.Node ->
                        "node"

        stringArray values =
            "[" ++ String.join ", " (Array.map quote values) ++ "]"
    in
    when outline is
        App app ->
            "[application]\n"
                ++ line "geng" (quote (SemanticVersionRange.toString app.gengVersion))
                ++ line "runtime" (runtime app.platform)
                ++ line "source-directories" (stringArray (Array.map Path.toPosixString app.sourceDirectories))
                ++ dependencies app.dependencies

        Pkg pkg ->
            "[package]\n"
                ++ line "name" (quote (PackageName.toString pkg.name))
                ++ line "version" (quote (SemanticVersion.toString pkg.version))
                ++ line "summary" (quote pkg.summary)
                ++ line "license" (quote (License.toString pkg.license))
                ++ line "geng" (quote (SemanticVersionRange.toString pkg.gengVersion))
                ++ "\n[platform]\n"
                ++ line "runtime" (quote (Runtime.toString pkg.runtime))
                ++ "\n[modules]\n"
                ++ (when pkg.exposedModules is
                        ExposedArray names ->
                            line "exposed" (stringArray (Array.map ModuleName.toString names))

                        ExposedDict groups ->
                            Dict.foldl
                                (\group names acc -> acc ++ line (quote group) (stringArray (Array.map ModuleName.toString names)))
                                "\n[modules.exposed]\n"
                                groups
                   )
                ++ dependencies pkg.dependencies


{-| A TOML basic string.
-}
quote : String -> String
quote value =
    let
        escape char =
            when char is
                '"' ->
                    "\\\""

                '\\' ->
                    "\\\\"

                '\n' ->
                    "\\n"

                '\t' ->
                    "\\t"

                '\r' ->
                    "\\r"

                _ ->
                    if Char.toCode char < 0x20 || Char.toCode char == 0x7F then
                        "\\u" ++ String.padLeft 4 '0' (hex (Char.toCode char))

                    else
                        String.fromChar char

        hex n =
            String.fromChar (hexDigit (n // 16)) ++ String.fromChar (hexDigit (modBy 16 n))

        hexDigit d =
            String.toArray "0123456789ABCDEF"
                |> Array.get d
                |> Maybe.withDefault '0'
    in
    "\"" ++ String.foldl (\char acc -> acc ++ escape char) "" value ++ "\""


{-| Set one dependency's range in the text of a `geng.toml`, leaving everything
else in the file as it was written, comments included.
-}
setDependency : String -> SemanticVersionRange -> String -> Result String String
setDependency name range text =
    Toml.parse text
        |> Result.mapError Toml.errorToString
        |> Result.map
            (\document ->
                document
                    |> Toml.Edit.set [ "dependencies", name ] (Toml.Edit.string (SemanticVersionRange.toString range))
                    |> Toml.toString
            )


{-| Remove one dependency from the text of a `geng.toml`, leaving everything else
as it was written.
-}
removeDependency : String -> String -> Result String String
removeDependency name text =
    Toml.parse text
        |> Result.mapError Toml.errorToString
        |> Result.map
            (\document ->
                document
                    |> Toml.Edit.remove [ "dependencies", name ]
                    |> Toml.toString
            )


-- JSON


{-| JSON Decoder for the [PkgOutline](#PkgOutline) in a package bundle.
-}
pkgJsonDecoder : Json.Decode.Decoder PkgOutline
pkgJsonDecoder =
    Json.Decode.map8
        (\platform name summary license version exposedModules gengVersion dependencies ->
            { runtime = Runtime.fromPlatform platform
            , target = Nothing
            , name = name
            , summary = summary
            , license = license
            , version = version
            , exposedModules = exposedModules
            , gengVersion = gengVersion
            , dependencies = dependencies
            , sources = Dict.empty
            }
        )
        (Json.Decode.field "platform" Platform.jsonDecoder)
        (Json.Decode.field "name" PackageName.jsonDecoder)
        (Json.Decode.field "summary" Json.Decode.string)
        (Json.Decode.field "license" License.jsonDecoder)
        (Json.Decode.field "version" SemanticVersion.jsonDecoder)
        (Json.Decode.field "exposed-modules" exposedModulesJsonDecoder)
        (Json.Decode.field "gren-version" SemanticVersionRange.jsonDecoder)
        (Json.Decode.field "dependencies" (Json.Decode.dict SemanticVersionRange.jsonDecoder))


exposedModulesJsonDecoder : Json.Decode.Decoder Exposed
exposedModulesJsonDecoder =
    Json.Decode.oneOf
        [ Json.Decode.array ModuleName.jsonDecoder
            |> Json.Decode.map ExposedArray
        , Json.Decode.dict (Json.Decode.array ModuleName.jsonDecoder)
            |> Json.Decode.map ExposedDict
        ]


exposedModulesEncoder : Exposed -> Encode.Value
exposedModulesEncoder exposed =
    when exposed is
        ExposedArray names ->
            Encode.array ModuleName.toJson names

        ExposedDict dictOfNames ->
            Encode.dict identity (Encode.array ModuleName.toJson) dictOfNames


{-| The outline as JSON, for the backend and for a package bundle.

The shape is `gren.json`'s, which is what the backend decodes, and nothing in it
is read by a person. An application's dependencies there are the versions
chosen for them, so the chosen versions are passed in: the ones the application
lists become `direct` and the rest `indirect`. A package's are its ranges, and
it ignores the versions.
-}
toJson : Dict String SemanticVersion -> Outline -> Encode.Value
toJson chosen outline =
    when outline is
        App app ->
            let
                encodeChosen deps =
                    Encode.dict identity SemanticVersion.toJson deps
            in
            Encode.object
                [ { key = "type", value = Encode.string "application" }
                , { key = "platform", value = Platform.toJson app.platform }
                , { key = "target", value = Encode.string app.target }
                , { key = "source-directories", value = Encode.array (Encode.string << Path.toPosixString) app.sourceDirectories }
                , { key = "gren-version", value = SemanticVersion.toJson (SemanticVersionRange.lowerBound app.gengVersion) }
                , { key = "dependencies"
                  , value =
                    Encode.object
                        [ { key = "direct", value = encodeChosen (Dict.keepIf (\name _ -> Dict.member name app.dependencies) chosen) }
                        , { key = "indirect", value = encodeChosen (Dict.keepIf (\name _ -> not (Dict.member name app.dependencies)) chosen) }
                        ]
                  }
                ]

        Pkg pkg ->
            Encode.object
                ([ { key = "type", value = Encode.string "package" }
                -- A runtime the compiler does not build for goes by its own
                -- name, which the backend refuses. PackageInstall has refused
                -- it first, in a project and in each dependency (D319).
                , { key = "platform"
                  , value =
                    when Runtime.toPlatform pkg.runtime is
                        Just platform ->
                            Platform.toJson platform

                        Nothing ->
                            Encode.string (Runtime.toString pkg.runtime)
                  }
                , { key = "name", value = PackageName.toJson pkg.name }
                , { key = "summary", value = Encode.string pkg.summary }
                , { key = "license", value = License.toJson pkg.license }
                , { key = "version", value = SemanticVersion.toJson pkg.version }
                , { key = "exposed-modules", value = exposedModulesEncoder pkg.exposedModules }
                , { key = "gren-version", value = SemanticVersionRange.toJson pkg.gengVersion }
                , { key = "dependencies", value = Encode.dict identity SemanticVersionRange.toJson pkg.dependencies }
                ]
                    ++ (when pkg.target is
                            Nothing ->
                                []

                            Just AnyTarget ->
                                [ { key = "target", value = Encode.string "any" } ]

                            Just (Targets names) ->
                                [ { key = "target", value = Encode.array Encode.string names } ]
                       )
                )
