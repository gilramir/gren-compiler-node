module Main exposing (main)

import Bytes exposing (Bytes)
import Node
import Task exposing (Task)
import FileSystem
import FileSystem.Path as Path
import FileSystem.Lock as Lock
import Compiler.Paths as Paths
import Compiler.Outline as Outline
import Stream
import Json.Decode as Decode
import Json.Encode as Encode
import Process


main : Task Never {}
main =
    Task.await Node.getEnvironment <| \env ->
    Task.await FileSystem.initialize <| \fsPerm ->
        when Array.get 2 env.args is
            Just "find gren.json" ->
                Paths.projectOutline fsPerm
                    |> Task.map Path.toPosixString
                    |> Task.onError (\fsErr -> Task.succeed (FileSystem.errorCode fsErr))
                    |> Task.andThen (log env.stdout)

            Just "parse gren.json" ->
                Paths.projectOutline fsPerm
                    |> Task.andThen (\grenJsonPath ->
                        FileSystem.readFile fsPerm grenJsonPath
                            |> Task.map (Maybe.withDefault "" << Bytes.toString)
                            |> Task.map
                                (\json ->
                                    json
                                        |> Decode.decodeString Outline.jsonDecoder
                                        |> Result.map (Outline.toJson >> Encode.encode 4)
                                        |> Result.withDefault "{}"
                                )
                    )
                    |> Task.onError (\fsErr -> Task.succeed (FileSystem.errorCode fsErr))
                    |> Task.andThen (log env.stdout)

            Just "lock" ->
                let
                    lockTime =
                        Array.get 3 env.args
                            |> Maybe.andThen String.toInt
                            |> Maybe.withDefault 0

                    maybeRetryOptions =
                        Array.get 4 env.args
                            |> Maybe.andThen String.toInt
                            |> Maybe.map (\wait -> { attempts = 3, millisecondsBetween = wait })
                in
                log env.stdout "Lock Aquired"
                    |> Task.andThen (\_ -> Process.sleep (toFloat lockTime))
                    |> Lock.withLock fsPerm maybeRetryOptions Path.empty
                    |> Task.andThen (\_ -> log env.stdout "Lock Released")
                    |> Task.onError
                        (\error ->
                            when error is
                                Lock.AlreadyLocked _ ->
                                    log env.stdout "Already Locked"

                                _ ->
                                    log env.stdout "Error"
                        )

            _ ->
                log env.stdout "Invalid start argument"


log : Stream.Writable Bytes -> String -> Task x {}
log stdout msg =
    Stream.writeLineAsBytes msg stdout
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})
